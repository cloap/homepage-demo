<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>徐可 · 个人主页</title>
  <style>
    :root {
      --bg: #f6f7fb;
      --card: #ffffff;
      --text: #1f2733;
      --muted: #6b7280;
      --accent: #2563eb;
      --accent-soft: #eaf1ff;
      --border: #e6e8ef;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                   "Microsoft YaHei", "Hiragino Sans GB", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 48px 24px 64px;
    }

    /* 顶部头像与标题 */
    .hero {
      text-align: center;
      padding: 40px 24px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: 0 8px 30px rgba(31, 39, 51, 0.06);
    }

    .avatar {
      width: 96px;
      height: 96px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 34px;
      font-weight: 600;
      letter-spacing: 2px;
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.3);
    }

    .hero h1 {
      font-size: 30px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .tagline {
      margin-top: 8px;
      color: var(--accent);
      font-size: 16px;
      font-weight: 500;
    }

    /* 通用卡片 */
    .card {
      margin-top: 24px;
      padding: 28px 28px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(31, 39, 51, 0.04);
    }

    .card h2 {
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card h2::before {
      content: "";
      width: 4px;
      height: 18px;
      border-radius: 2px;
      background: var(--accent);
    }

    .card p { color: var(--muted); }

    /* 爱好 */
    .hobbies {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 8px;
    }

    .hobby {
      padding: 20px;
      background: var(--accent-soft);
      border-radius: 12px;
      text-align: center;
    }

    .hobby .icon { font-size: 32px; }
    .hobby .name { margin-top: 8px; font-weight: 600; }
    .hobby .desc { margin-top: 4px; font-size: 13px; color: var(--muted); }

    /* 底部 */
    .footer {
      margin-top: 32px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    .footer a { color: var(--accent); text-decoration: none; }

    @media (max-width: 480px) {
      .hobbies { grid-template-columns: 1fr; }
      .hero h1 { font-size: 26px; }
    }
  </style>
</head>
<body>
  <div class="container">

    <!-- 顶部 -->
    <section class="hero">
      <div class="avatar">徐可</div>
      <h1>徐可</h1>
      <p class="tagline">金融专硕在读</p>
    </section>

    <!-- 关于我 -->
    <section class="card">
      <h2>关于我</h2>
      <p>
        你好，我是徐可，一名金融专业硕士研究生。我对金融市场、资产定价与数据分析充满兴趣，
        目前在读期间专注于宏观经济与量化方向的学习，希望用数据与代码更好地理解金融世界。
      </p>
    </section>

    <!-- 爱好 -->
    <section class="card">
      <h2>兴趣爱好</h2>
      <div class="hobbies">
        <div class="hobby">
          <div class="icon">🎵</div>
          <div class="name">音乐</div>
          <div class="desc">喜欢在旋律里放松，偶尔弹琴</div>
        </div>
        <div class="hobby">
          <div class="icon">🏃</div>
          <div class="name">运动</div>
          <div class="desc">坚持跑步与健身，保持好状态</div>
        </div>
      </div>
    </section>

    <!-- 研究方向 -->
    <section class="card">
      <h2>学习方向</h2>
      <p>
        宏观经济分析 · 金融市场 · 量化金融 · 数据分析<br />
        常用工具：Python、Pandas、Excel
      </p>
    </section>

    <!-- 底部 -->
    <footer class="footer">
      © 2026 徐可 · 个人主页
    </footer>

  </div>
</body>
</html>


